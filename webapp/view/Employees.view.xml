<mvc:View
    controllerName="northwind.controller.Employees"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
        showHeader="false"
    >
        <!-- flex box does both kinds of alignments -->

        <HBox alignItems="Center">
            <VBox class="sapUiSmallMargin">
                <Label text="Employee Id" />
                <Input
                    id="EmployeeID"
                    placeholder="Search by ID"
                />
            </VBox>

            <VBox class="sapUiSmallMargin">
                <Label text="Country" />
                <Input
                    id="Country"
                    placeholder="Search by Country"
                />
            </VBox>

            <VBox class="sapUiSmallMargin">
                <Label text="Hire Date" />
                <DateRangeSelection
                    id="DRS"
                    showCurrentDateButton="true"
                    showFooter="true"
                    displayFormat="dd-MM-yyyy"
                />
            </VBox>

			<Button 
			class="sapUiSmallMargin"
			text="Filter"
			press="onFilter"
			></Button>

			<Button 
			class="sapUiSmallMargin"
			text="Clear"
			press="onClearFilter"
			></Button>
        </HBox>

        <!-- <SearchField 
    id="EmployeeID"
    ></SearchField> -->

        <Table
            id="employeesTable"
            inset="false"
            items="{
			path: '/Employees'
			
		}"
            growing="true"
            growingThreshold="5"
			mode="SingleSelectMaster"
			itemPress="onPress"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <content>
                        <Title
                            text="Employees"
                            level="H2"
                        />
                        <ToolbarSpacer />
                        <!-- Basically a dropdown -->
                        <!-- <ComboBox id="idPopinLayout"
						placeholder="Popin layout options"
						change=".onPopinLayoutChanged">
						<items>
							<core:Item  text="Block"
								key="Block"/>
							<core:Item  text="Grid Large"
								key="GridLarge"/>
							<core:Item  text="Grid Small"
								key="GridSmall"/>
						</items>
					</ComboBox> -->
                        <!-- <Label text="Sticky options:" />
					<CheckBox text="ColumnHeaders"
						select=".onSelect"/>
					<CheckBox text="HeaderToolbar"
						select=".onSelect"/>
					<CheckBox text="InfoToolbar"
						select=".onSelect"/>
					<ToggleButton id="toggleInfoToolbar"
						text="Hide/Show InfoToolbar"
						press=".onToggleInfoToolbar" /> -->
                    </content>
                </OverflowToolbar>
            </headerToolbar>
            <!-- <infoToolbar>
			<OverflowToolbar>
				<Label text="Wide range of available products"/>
			</OverflowToolbar>
		</infoToolbar> -->
            <columns>
                <Column width="12em">
                    <Text text="Employee ID" />

                    <!-- this is to add the "generated by ai" -->
                    <!-- <dependents>
					<p:ColumnAIAction press=".onAIActionPress"></p:ColumnAIAction>
				</dependents> -->
                </Column>
                <Column
                    minScreenWidth="Tablet"
                    demandPopin="true"
                >
                    <Text text="Name" />
                </Column>

                <Column
                    minScreenWidth="Desktop"
                    demandPopin="true"
                >
                    <Text text="Title" />
                </Column>
                <Column
                    minScreenWidth="Desktop"
                    demandPopin="true"
                >
                    <Text text="Hire Date" />
                </Column>
                <Column
                    minScreenWidth="Desktop"
                    demandPopin="true"
                >
                    <Text text="City" />
                </Column>
                <Column>
                    <Text text="Country" />
                </Column>
            </columns>
            <items>
                <ColumnListItem vAlign="Middle" type="Active">
                    <cells>
                        <!-- multiple elements in the same column -->
                        <!-- <ObjectIdentifier
						title="{Name}"
						text="{ProductId}"/> -->

                        <Text text="{EmployeeID}" />
                        <Text text="{FirstName} {LastName}" />
                        <Text text="{Title}" />
                        <Text text="{path:'HireDate', formatter:'.formatter.formatDate'}" />
                        <Text text="{City}" />
                        <Text text="{Country}" />

                        <!-- elements with SI Units use object number -->
                        <!-- <ObjectNumber
						number="{WeightMeasure}"
						unit="{WeightUnit}"
						state="{
                        if we are passing multiple fields we use parts
							parts: [
								{path: 'WeightMeasure'},
								{path: 'WeightUnit'}
							],
							formatter: '.formatter.weightState'
						}" /> -->
                        <!-- <ObjectNumber
						number="{
							parts:[{path:'Price'},{path:'CurrencyCode'}],
							type: 'sap.ui.model.type.Currency',
							formatOptions: {showMeasure: false}
						}"
						unit="{CurrencyCode}" /> -->
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>
